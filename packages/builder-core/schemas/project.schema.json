{
  "$defs": {
    "urn:egeria-systems:schema:safe-relative-path:1.0.0": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!\\/)(?![A-Za-z]:\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[^/]+(?:\\/[^/]+)*$",
      "type": "string"
    },
    "urn:egeria-systems:schema:stable-identifier:1.0.0": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "builderCompatibility": {
      "const": "0.0.0",
      "type": "string"
    },
    "capabilitySettings": {
      "additionalProperties": {
        "not": {}
      },
      "propertyNames": {
        "$ref": "#/$defs/urn:egeria-systems:schema:stable-identifier:1.0.0"
      },
      "readOnly": true,
      "type": "object"
    },
    "ejectedAreas": {
      "items": {
        "$ref": "#/$defs/urn:egeria-systems:schema:safe-relative-path:1.0.0"
      },
      "readOnly": true,
      "type": "array"
    },
    "originProfile": {
      "enum": [
        "portfolio",
        "site"
      ],
      "type": "string"
    },
    "platformAdapter": {
      "const": "cloudflare-workers",
      "type": "string"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "defaultLocale": {
          "const": "en-CA",
          "type": "string"
        },
        "displayName": {
          "pattern": "^(?=.{1,120}$)(?=.*\\S)[^\\p{Cc}]+$",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/urn:egeria-systems:schema:stable-identifier:1.0.0"
        }
      },
      "readOnly": true,
      "required": [
        "name",
        "displayName",
        "defaultLocale"
      ],
      "type": "object"
    },
    "recipeVersion": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ],
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "selectedCapabilities": {
      "items": {
        "$ref": "#/$defs/urn:egeria-systems:schema:stable-identifier:1.0.0"
      },
      "minItems": 1,
      "readOnly": true,
      "type": "array"
    }
  },
  "readOnly": true,
  "required": [
    "schemaVersion",
    "builderCompatibility",
    "project",
    "originProfile",
    "recipeVersion",
    "platformAdapter",
    "selectedCapabilities",
    "capabilitySettings",
    "ejectedAreas"
  ],
  "title": "Egeria project configuration",
  "type": "object"
}
