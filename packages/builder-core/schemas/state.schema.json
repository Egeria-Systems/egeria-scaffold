{
  "$defs": {
    "urn:egeria-systems:schema:json-pointer:1.0.0": {
      "pattern": "^(?:\\/(?:[^~/]|~[01])*)*$",
      "type": "string"
    },
    "urn:egeria-systems:schema:safe-relative-path:1.0.0": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!\\/)(?![A-Za-z]:\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[^/]+(?:\\/[^/]+)*$",
      "type": "string"
    },
    "urn:egeria-systems:schema:semantic-version:1.0.0": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "urn:egeria-systems:schema:sha256-fingerprint:1.0.0": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "urn:egeria-systems:schema:stable-identifier:1.0.0": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appliedMigrations": {
      "items": {
        "$ref": "#/$defs/urn:egeria-systems:schema:stable-identifier:1.0.0"
      },
      "readOnly": true,
      "type": "array"
    },
    "builderVersion": {
      "const": "0.0.0",
      "type": "string"
    },
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "const": "22.23.0",
          "type": "string"
        },
        "platformAdapter": {
          "const": "cloudflare-workers",
          "type": "string"
        },
        "pnpm": {
          "const": "11.20.0",
          "type": "string"
        }
      },
      "readOnly": true,
      "required": [
        "node",
        "pnpm",
        "platformAdapter"
      ],
      "type": "object"
    },
    "ejections": {
      "items": {
        "$ref": "#/$defs/urn:egeria-systems:schema:safe-relative-path:1.0.0"
      },
      "readOnly": true,
      "type": "array"
    },
    "installedCapabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "deliveryMode": {
            "enum": [
              "package-backed",
              "source-generated",
              "hybrid"
            ],
            "type": "string"
          },
          "identifier": {
            "$ref": "#/$defs/urn:egeria-systems:schema:stable-identifier:1.0.0"
          },
          "removalPolicy": {
            "enum": [
              "automatic",
              "reviewed",
              "export-and-remove",
              "eject-only",
              "unsupported"
            ],
            "type": "string"
          },
          "stateClassifications": {
            "items": {
              "enum": [
                "stateless",
                "repository-stateful",
                "external-stateful",
                "persistent-data"
              ],
              "type": "string"
            },
            "minItems": 1,
            "readOnly": true,
            "type": "array"
          },
          "version": {
            "$ref": "#/$defs/urn:egeria-systems:schema:semantic-version:1.0.0"
          }
        },
        "readOnly": true,
        "required": [
          "identifier",
          "version",
          "deliveryMode",
          "stateClassifications",
          "removalPolicy"
        ],
        "type": "object"
      },
      "readOnly": true,
      "type": "array"
    },
    "lastSuccessfulVerification": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "prefixItems": [
            {
              "const": "contracts",
              "type": "string"
            },
            {
              "const": "pre-state-inference",
              "type": "string"
            },
            {
              "const": "lockfile",
              "type": "string"
            },
            {
              "const": "frozen-install",
              "type": "string"
            },
            {
              "const": "lint",
              "type": "string"
            },
            {
              "const": "typecheck",
              "type": "string"
            },
            {
              "const": "next-build",
              "type": "string"
            },
            {
              "const": "opennext-build",
              "type": "string"
            },
            {
              "const": "post-state-inference",
              "type": "string"
            }
          ],
          "readOnly": true,
          "type": "array"
        },
        "kind": {
          "const": "generation",
          "type": "string"
        }
      },
      "readOnly": true,
      "required": [
        "kind",
        "checks"
      ],
      "type": "object"
    },
    "managedSurfaces": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "$ref": "#/$defs/urn:egeria-systems:schema:sha256-fingerprint:1.0.0"
          },
          "fingerprintTarget": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "file",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "json-value",
                    "type": "string"
                  },
                  "pointer": {
                    "$ref": "#/$defs/urn:egeria-systems:schema:json-pointer:1.0.0"
                  }
                },
                "required": [
                  "kind",
                  "pointer"
                ],
                "type": "object"
              }
            ],
            "readOnly": true
          },
          "identifier": {
            "$ref": "#/$defs/urn:egeria-systems:schema:stable-identifier:1.0.0"
          },
          "mergeStrategy": {
            "enum": [
              "replace-file",
              "json-property"
            ],
            "type": "string"
          },
          "owner": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "builder-kernel",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "identifier": {
                    "$ref": "#/$defs/urn:egeria-systems:schema:stable-identifier:1.0.0"
                  },
                  "kind": {
                    "const": "capability",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "identifier"
                ],
                "type": "object"
              }
            ],
            "readOnly": true
          },
          "ownership": {
            "enum": [
              "managed",
              "merge-managed",
              "application-owned",
              "ejected"
            ],
            "type": "string"
          },
          "path": {
            "$ref": "#/$defs/urn:egeria-systems:schema:safe-relative-path:1.0.0"
          }
        },
        "readOnly": true,
        "required": [
          "identifier",
          "owner",
          "path",
          "ownership",
          "fingerprintTarget",
          "mergeStrategy",
          "fingerprint"
        ],
        "type": "object"
      },
      "readOnly": true,
      "type": "array"
    },
    "origin": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "portfolio",
            "site"
          ],
          "type": "string"
        },
        "recipeVersion": {
          "const": "0.1.0",
          "type": "string"
        }
      },
      "readOnly": true,
      "required": [
        "profile",
        "recipeVersion"
      ],
      "type": "object"
    },
    "projectSchemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    }
  },
  "readOnly": true,
  "required": [
    "schemaVersion",
    "builderVersion",
    "projectSchemaVersion",
    "origin",
    "installedCapabilities",
    "appliedMigrations",
    "managedSurfaces",
    "ejections",
    "compatibility",
    "lastSuccessfulVerification"
  ],
  "title": "Egeria installed state",
  "type": "object"
}
