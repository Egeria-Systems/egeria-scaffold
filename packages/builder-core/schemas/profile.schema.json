{
  "$defs": {
    "urn:egeria-systems:schema:profile:1.0.0": {
      "additionalProperties": false,
      "properties": {
        "defaultCapabilities": {
          "items": {
            "$ref": "#/$defs/urn:egeria-systems:schema:stable-identifier:1.0.0"
          },
          "minItems": 1,
          "readOnly": true,
          "type": "array"
        },
        "identifier": {
          "enum": [
            "portfolio",
            "site",
            "app"
          ],
          "type": "string"
        },
        "recipeVersion": {
          "enum": [
            "0.11.7",
            "0.12.7",
            "0.2.7",
            "0.12.0",
            "0.13.0",
            "0.3.0"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0.0",
          "type": "string"
        }
      },
      "readOnly": true,
      "required": [
        "identifier",
        "schemaVersion",
        "recipeVersion",
        "defaultCapabilities"
      ],
      "title": "Egeria portfolio, site, and app profile recipe",
      "type": "object"
    },
    "urn:egeria-systems:schema:stable-identifier:1.0.0": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    }
  },
  "$ref": "#/$defs/urn:egeria-systems:schema:profile:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
