        enabled: true
        content:
          heading: {{displayNameJson}}
          summary: A concise introduction to selected work.
      - id: approach
        type: text
        variant: default
        enabled: true
        content:
          heading: Approach
          body: Thoughtful work begins with clear goals and practical decisions.
      - id: selected-work
        type: project-list
        variant: default
        enabled: true
        content:
          heading: Selected work
          projects:
            - title: Example project
              summary: A representative project demonstrating focused delivery.
              href: https://example.com/work/example-project
      - id: contact
        type: call-to-action
