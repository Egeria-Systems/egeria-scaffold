{
  "name": "@egeria-systems/builder-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm --dir ../.. exec eslint packages/builder-core/src --max-warnings 0",
    "schema:check": "node scripts/generate-json-schemas.mjs --check",
    "schema:generate": "node scripts/generate-json-schemas.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:generated-project": "node --test tests/generate-project.integration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run build && pnpm run schema:check && pnpm run test && pnpm run typecheck && pnpm run lint"
  },
  "dependencies": {
    "typescript": "6.0.3",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@egeria-systems/standards": "workspace:*",
    "@types/node": "22.20.1"
  }
}
